    {
      "parameters": {
        "method": "POST",
        "url": "https://api.anthropic.com/v1/messages",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "anthropic-version",
              "value": "2023-06-01"
            },
            {
              "name": "content-type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "=\n{{\n  JSON.stringify({\n    model: \"claude-haiku-4-5-20251001\",\n    max_tokens: 500,\n    messages: [\n      {\n        role: \"user\",\n        content: `You are an AI assistant analysing refund requests for an online retailer.\n\nAnalyse the following refund request:\n\nCustomer: ${$('Webhook').item.json.body.customer_name}\nOrder ID: ${$('Webhook').item.json.body.order_id}\nRefund Amount: $${$('Webhook').item.json.body.refund_amount}\nPurchase Date: ${$('Webhook').item.json.body.purchase_date}\nRefund Reason: ${$('Webhook').item.json.body.refund_reason}\n\nReturn ONLY a valid JSON object containing:\n{\n  \"category\": \"faulty_product | wrong_item | change_of_mind | missing_delivery | other\",\n  \"risk_level\": \"low | medium | high\",\n  \"summary\": \"Brief summary of the refund request\",\n  \"recommendation\": \"approve | manager_review\",\n  \"reasoning\": \"Brief explanation of your recommendation\"\n}\n\nDo not include Markdown or additional text. Your recommendation is advisory only. Do not claim that the refund has been approved.`\n      }\n    ]\n  })\n}}\n",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
