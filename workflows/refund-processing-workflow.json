      "id": "3153982f-48a8-443c-852a-310ae77e98c3",
      "name": "Webhook"
    },
    {
      "parameters": {
        "jsCode": "\nconst analysis = $input.first().json;\nconst request = $('Webhook').first().json.body;\n\nconst refundAmount = Number(request.refund_amount);\n\nconst purchaseDate = new Date(request.purchase_date);\nconst today = new Date();\n\nconst daysSincePurchase = Math.floor(\n    (today - purchaseDate) / (1000 * 60 * 60 * 24)\n);\n\nconst eligibleCategories = [\n    \"faulty_product\",\n    \"wrong_item\"\n];\n\nconst reviewReasons = [];\n\nif (refundAmount > 50) {\n    reviewReasons.push(\"Refund exceeds $50 limit\");\n}\n\nif (daysSincePurchase > 30) {\n    reviewReasons.push(\"Purchase is older than 30 days\");\n}\n\nif (!eligibleCategories.includes(analysis.category)) {\n    reviewReasons.push(\"Refund category requires review\");\n}\n\nif (analysis.risk_level !== \"low\") {\n    reviewReasons.push(\"AI identified elevated or unknown risk\");\n}\n\nif (analysis.recommendation !== \"approve\") {\n    reviewReasons.push(\"AI did not recommend approval\");\n}\n\nif (\n    !request.customer_name ||\n    !request.customer_email ||\n    !request.order_id ||\n    !request.refund_reason ||\n    !Number.isFinite(refundAmount) ||\n    refundAmount <= 0 ||\n    Number.isNaN(purchaseDate.getTime()) ||\n    daysSincePurchase < 0\n) {\n    reviewReasons.push(\"Missing or invalid request information\");\n}\n\nconst decision = reviewReasons.length === 0\n    ? \"auto_approved\"\n    : \"pending_review\";\n\nreturn [{\n    json: {\n        ...analysis,\n        refund_amount: refundAmount,\n        days_since_purchase: daysSincePurchase,\n        decision,\n        review_reasons: reviewReasons\n    }\n}];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        896,
        0
      ],
