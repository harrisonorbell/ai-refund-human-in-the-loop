      "name": "Submit Manager Decision"
    },
    {
      "parameters": {
        "jsCode": "\nconst body = $input.first().json.body ?? {};\n\nconst requestId = Number(body.request_id);\nconst decision = body.decision;\nconst managerNotes = body.manager_notes;\n\nif (!Number.isSafeInteger(requestId) || requestId <= 0) {\n    throw new Error(\"Invalid refund request ID.\");\n}\n\nif (![\"approved\", \"rejected\"].includes(decision)) {\n    throw new Error(\"Decision must be approved or rejected.\");\n}\n\nif (\n    typeof managerNotes !== \"string\" ||\n    managerNotes.trim().length < 5\n) {\n    throw new Error(\"Manager must provide a reason of at least 5 characters.\");\n}\n\nreturn [{\n    json: {\n        request_id: requestId,\n        decision: decision,\n        manager_notes: managerNotes.trim()\n    }\n}];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        224,
